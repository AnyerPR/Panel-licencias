rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: comprobar si el usuario está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: comprobar si el usuario es un administrador registrado en /admins/{uid}
    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.activo == true;
    }

    // Helper: comprobar si el sistema no ha sido inicializado aún (primer uso)
    function isInitialSetup() {
      return !exists(/databases/$(database)/documents/configuracion/public) ||
        !('setupCompleted' in get(/databases/$(database)/documents/configuracion/public).data) ||
        get(/databases/$(database)/documents/configuracion/public).data.setupCompleted != true;
    }

    // Acceso para todas las colecciones del sistema gestionadas a través del backend Express
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
